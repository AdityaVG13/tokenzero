  e_anti(7) = 145/448 ; vs 1/3: 3*145 = 435 < 448 -> e7 < 1/3: True
  e_anti(8) = 43/128 ; vs 1/3: 3*43 = 129 > 128 -> e8 > 1/3: True
  margin e8 - 1/3 = 1/384 (claimed min margin 1/384 at n=8)

  n | e_anti | 4/e_anti (Fable one-bit component) | rho_kill full law (Kimi)
