{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenzero.dev/schemas/tokenzero.observatory.v1.schema.json",
  "title": "TokenZero Session Observatory v1",
  "description": "Turn-level model-facing cost decomposition derived from tokenzero.ledger.v1. The four cost_buckets are disjoint and sum to model_facing_total_tokens. tool_result_visible_tokens is the original ledger cost before expand results are moved into the expand bucket.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session", "sample", "methodology", "source", "totals", "turns", "losses_disclosed"],
  "properties": {
    "schema": {"const": "tokenzero.observatory.v1"},
    "session": {
      "type": "object",
      "required": ["session_id", "repo", "agent", "version"],
      "properties": {
        "session_id": {"type": ["string", "null"]},
        "repo": {"type": ["string", "null"]},
        "agent": {"type": ["string", "null"]},
        "version": {"type": ["object", "null"]}
      }
    },
    "sample": {
      "type": "object",
      "required": ["turns_n", "malformed_records_n", "ignored_schema_records_n"],
      "properties": {
        "turns_n": {"type": "integer", "minimum": 0},
        "malformed_records_n": {"type": "integer", "minimum": 0},
        "ignored_schema_records_n": {"type": "integer", "minimum": 0}
      }
    },
    "methodology": {"type": "object"},
    "source": {"type": "object"},
    "totals": {"$ref": "#/$defs/totals"},
    "turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}},
    "losses_disclosed": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "buckets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot_envelope_tokens", "tool_schema_tokens", "tool_result_tokens", "expand_materialization_tokens"],
      "properties": {
        "boot_envelope_tokens": {"type": "integer", "minimum": 0},
        "tool_schema_tokens": {"type": "integer", "minimum": 0},
        "tool_result_tokens": {"type": "integer", "minimum": 0},
        "expand_materialization_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot_envelope_tokens", "tool_schema_tokens", "tool_result_tokens", "expand_materialization_tokens", "tool_result_visible_tokens", "model_facing_total_tokens"],
      "properties": {
        "boot_envelope_tokens": {"type": "integer", "minimum": 0},
        "tool_schema_tokens": {"type": "integer", "minimum": 0},
        "tool_result_tokens": {"type": "integer", "minimum": 0},
        "expand_materialization_tokens": {"type": "integer", "minimum": 0},
        "tool_result_visible_tokens": {"type": "integer", "minimum": 0},
        "model_facing_total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_index", "timestamp_ms", "tool", "accounting_source", "cost_buckets", "tool_result_visible_tokens", "model_facing_total_tokens", "ledger_token_mass", "cumulative_session_cost_tokens", "optimization_tags"],
      "properties": {
        "turn_index": {"type": "integer", "minimum": 1},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "tool": {"type": "string"},
        "accounting_source": {"enum": ["tokenzero.ledger.v1", "mcp_capture"]},
        "cost_buckets": {"$ref": "#/$defs/buckets"},
        "tool_result_visible_tokens": {"type": "integer", "minimum": 0},
        "model_facing_total_tokens": {"type": "integer", "minimum": 0},
        "ledger_token_mass": {"type": ["object", "null"]},
        "cumulative_session_cost_tokens": {"type": "integer", "minimum": 0},
        "optimization_tags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
