{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/derivation-provenance/v1/derivation-provenance.schema.json",
  "title": "ZeroStack derivation provenance record v1",
  "description": "Frozen shared shape for explainable derived rows. Freeze id zerostack.derivation-provenance.v1. Orthogonal to zerostack.cas-gc.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "row_id",
    "derived_kind",
    "derived_ref",
    "source_blob_digest",
    "byte_span",
    "producing_engine",
    "producing_commit",
    "transform_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "zerostack.derivation-provenance.v1"
    },
    "record_type": { "const": "derivation-provenance" },
    "row_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "derived_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "derived_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source_blob_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "byte_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "end": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "line_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "end": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "producing_engine": { "enum": ["tokenzero", "fszero", "graphzero"] },
    "producing_commit": { "type": "string", "minLength": 1, "maxLength": 128 },
    "transform_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "edge_src": { "type": "string", "minLength": 1, "maxLength": 512 },
    "edge_dst": { "type": "string", "minLength": 1, "maxLength": 512 },
    "edge_kind": { "type": "integer", "minimum": 0, "maximum": 255 }
  }
}
