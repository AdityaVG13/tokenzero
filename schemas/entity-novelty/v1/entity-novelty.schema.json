{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerostack.dev/schemas/entity-novelty/v1/entity-novelty.schema.json",
  "title": "ZeroStack entity novelty record v1",
  "description": "Frozen shared known-entity set for cross-engine novelty. Freeze id zerostack.entity-novelty.v1. Entity ids are GraphZero EntityId digests; refs remain gz://entity/<id> only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "scope_key",
    "entity_ids",
    "producing_engine",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "zerostack.entity-novelty.v1"
    },
    "record_type": { "const": "entity-novelty" },
    "scope_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(session|repo|workspace):.+|^global$"
    },
    "entity_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    },
    "producing_engine": { "enum": ["tokenzero", "fszero", "graphzero"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "cas_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
